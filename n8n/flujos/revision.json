      "typeVersion": 1.1,
      "position": [
        880,
        200
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { id_transaccion: null, error: { tipo: 'entrada_invalida', mensaje: 'id_caso debe ser un texto con la forma c- y 12 cifras hexadecimales (minúsculas)', detalles: [] } } }}",
        "options": {
          "responseCode": 422
